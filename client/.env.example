# The base URL of the deployed application (used for share links)
# Defaults to window.location.origin in the browser if not set.
PUBLIC_BASE_URL=https://tempnote.yourdomain.com

# The base URL of the backend API
# If your backend is hosted separately, set this (e.g. https://api.yourdomain.com/api)
# Defaults to '/api' if not set.
PUBLIC_API_URL=https://api.yourdomain.com/api
